# Environment Variables
# Copy to .env.local and fill in values

# Required
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
OWNER_EMAIL=your-email@example.com
CRON_SECRET=your-cron-secret

# Optional: Auth0 MCP OAuth (required for ChatGPT connector)
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
AUTH0_AUDIENCE=https://api.your-app.com

# API-first image generation and worker
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-google-ai-studio-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
AI_WORKER_SECRET=replace-with-a-long-random-secret

# Quota per user per day (defaults: brain 200, image 100)
# AI_DAILY_LIMIT_BRAIN=200
# AI_DAILY_LIMIT_IMAGE=100

# Optional: absolute URL used in generated links, and MCP download allow-list
# NEXT_PUBLIC_APP_URL=https://your-deployment.example
# MCP_IMAGE_DOWNLOAD_HOSTS=cdn.example.com

# Optional: Auth0 subject that owns the workspace
# AUTH0_OWNER_SUB=auth0|xxxxxxxx

# Reusable Style Profiles (enabled by default)
# STYLE_PROFILES_ENABLED=true
# STYLE_ANALYSIS_PROVIDER=openai # openai | google; auto-detects Google first when omitted
# STYLE_ANALYSIS_MODEL=gpt-4o # defaults to gpt-4o or gemini-2.5-flash
# SUPABASE_FUNCTION_URL=https://your-project.supabase.co/functions/v1/ai-worker
